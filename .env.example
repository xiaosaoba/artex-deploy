# 复制为 .env 后填入真实值
ARTEX_IMAGE=ruoji6/artex
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=<设置一个强密码，避免 # ! @ 等特殊字符，否则 DSN 解析会失败>
POSTGRES_DB=artex

# LLM：OpenAI Chat Completions 兼容网关
ANTHROPIC_API_KEY=
OPENAI_API_KEY=<你的 API Key>
ARTEX_LLM_PROVIDER=openai
ARTEX_LLM_MODEL=glm-5.3
ARTEX_LLM_BASE_URL=https://ai-codex.jupyte.com/v1
ARTEX_LLM_PROXY=

ARTEX_HTTP_USER_AGENT=
